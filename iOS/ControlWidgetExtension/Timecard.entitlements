<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- MAIN APP entitlements. When wiring, move/reference this from the Timecard
     target (CODE_SIGN_ENTITLEMENTS). Adds the App Group so the app and the
     widget extension share one SwiftData store. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.thegrandpipeline.timecard</string>
    </array>
</dict>
</plist>
