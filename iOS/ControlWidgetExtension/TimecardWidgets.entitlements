<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- WIDGET EXTENSION entitlements. Same App Group as the app — this is what lets
     the extension open the shared SwiftData store. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.thegrandpipeline.timecard</string>
    </array>
</dict>
</plist>
